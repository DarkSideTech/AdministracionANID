{
  "ConnectionStrings": {
    "AUT2ServicesConnectionPostgreSql": "Host=host.docker.internal;Port=5432;Database=AUT2Services;Username=postgres;Password=postgres"
  },
  "DB_PROVIDER": "postgresql",
  "MongoAuditProjection": {
    "Enabled": true,
    "ConnectionString": "mongodb://host.docker.internal:27017",
    "DatabaseName": "AUT2ServicesTraceability",
    "CollectionName": "audit_trail",
    "BatchSize": 100,
    "IntervalSeconds": 5
  },
  "ShowSwagger": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5002"
      }
    }
  },
  "JwtOptions": {
    "AllowedCorsOrigins": [ "*" ],
    "ImplementCookieOptionsSecure": "false"
  }
}

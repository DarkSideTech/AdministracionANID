{
  "DB_PROVIDER": "postgresql",
  "MongoAuditProjection": {
    "Enabled": true,
    "DatabaseName": "AUT2ServicesTraceability",
    "CollectionName": "audit_trail",
    "BatchSize": 100,
    "IntervalSeconds": 5
  },
  "ShowSwagger": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5002"
      }
    }
  },
  "RefreshTokenCleanup": {
    "IntervalMinutes": 60
  },
  "JwtOptions": {
    "LoginOrganizationTokenTimeInMinutes": 15,
    "LoginTokenTimeInMinutes": 5,
    "RefreshTokenDays": 7,
    "AllowedCorsOrigins": [ "*" ],
    "ImplementCookieOptionsSecure": "false",
    "MaximaCantidadIntentosFallidos": 5
  },
  "EmailValidation": {
    "ExposeConfirmationUrlInDevelopment": true,
    "ResendCooldownMinutes": 2,
    "ResendRequestsPerWindow": 5,
    "ResendWindowMinutes": 10
  },
  "NotificationOutbox": {
    "Enabled": true,
    "BatchSize": 50,
    "IntervalSeconds": 5,
    "MaxAttempts": 5,
    "InitialRetryDelaySeconds": 30,
    "MaxRetryDelaySeconds": 900
  },
  "PasswordChange": {
    "CodeLength": 6,
    "CodeLifetimeMinutes": 10,
    "ResendCooldownSeconds": 60,
    "MaxFailedAttempts": 5
  }
}
